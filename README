спочатку запускаємо докерє
docker compose up -d

# endpoint

таблиця "pictures"

http://127.0.0.1:8000/api/pictures/

# get - список всієї таблиці
# post - створення нового запису

http://127.0.0.1:8000/api/pictures/{id}/

# get - показ обраного запису по id
# put - повне оновлення запису по id
# patch - часткове оновлення запису по id
# delete - видалення запису по id

Таблиця "about"

http://127.0.0.1:8000/api/about/

# get - список всієї таблиці
# post - створення нового запису

http://127.0.0.1:8000/api/about/{id}/

# get - показ обраного запису по id
# put - повне оновлення запису по id
# patch - часткове оновлення запису по id
# delete - видалення запису по id




















pictures

get - http://127.0.0.1:8000/api/pictures/ (список всієї таблиці)
post - http://127.0.0.1:8000/api/pictures/ (створення нового запису)
get - http://127.0.0.1:8000/api/pictures/[id]/ (показ обраного запису по id)
put - http://127.0.0.1:8000/api/pictures/[id]/ (повне оновлення запису по id)
patch - http://127.0.0.1:8000/api/pictures/[id]/ (часткове оновлення запису по id)
delete - http://127.0.0.1:8000/api/pictures/[id]/ (видалення запису по id)

about

get - http://127.0.0.1:8000/api/about/ (список всієї таблиці)
post - http://127.0.0.1:8000/api/about/ (створення нового запису)
get - http://127.0.0.1:8000/api/about/[id]/ (показ обраного запису по id)
put - http://127.0.0.1:8000/api/about/[id]/ (повне оновлення запису по id)
patch - http://127.0.0.1:8000/api/about/[id]/ (часткове оновлення запису по id)
delete - http://127.0.0.1:8000/api/about/[id]/ (видалення запису по i